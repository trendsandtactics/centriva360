# ----------------------------------------------------------------------
# Apache / cPanel configuration for Centriva360 React SPA & PHP Gateway
# ----------------------------------------------------------------------

# 1. Protect Sensitive Files (.env, .git, logs)
<FilesMatch "^\.env|^\.git|\.log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Options
Options -Indexes
Options +FollowSymLinks

# 3. MIME Types for Modern Web Assets
<IfModule mod_mime.c>
    AddType text/javascript js mjs
    AddType application/json json
    AddType image/svg+xml svg svgz
    AddType font/woff woff
    AddType font/woff2 woff2
    AddType video/mp4 mp4
    AddType video/webm webm
</IfModule>

# 4. Gzip Compression for Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. URL Rewrite Rules for React Router & PHP API Gateway
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to the PHP API
    RewriteRule ^api/ - [L]

    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other routes to index.html for client-side routing (React Router)
    RewriteRule ^ index.html [L]
</IfModule>
